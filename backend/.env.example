# Copy to .env for local development. No cloud credentials required.
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Set a random value of at least 32 characters in deployed environments.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# local | s3 (AWS SDK uses your IAM role / default credential chain)
STORAGE_MODE=local
AWS_REGION=us-east-1
S3_BUCKET_NAME=
# local | bedrock; changing engines requires reindexing all documents.
AI_ENGINE=local
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL=
# Optional: RDS PostgreSQL + pgvector. Empty host uses local JSON storage.
DB_HOST=
DB_PORT=5432
DB_NAME=cloudvault
DB_USER=cloudvault
DB_PASSWORD=
DB_SSL=false
# For RDS, supply a CA certificate path and enable DB_SSL.
DB_CA_FILE=
SQS_QUEUE_URL=
